<div class="field">
  <label for="title">Title</label>
  <input id="title" name="title" required
         minlength="<%= limits.title.min %>" maxlength="<%= limits.title.max %>"
         placeholder="e.g. Mountain bike, barely used"
         value="<%= values.title || '' %>">
  <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
</div>

<div class="field-row">
  <div class="field">
    <label for="category">Category</label>
    <select id="category" name="category" required>
      <option value="">Choose a category…</option>
      <% categories.forEach(function (category) { %>
        <option value="<%= category.slug %>" <%= values.category === category.slug ? 'selected' : '' %>>
          <%= category.name %>
        </option>
      <% }); %>
    </select>
    <% if (errors.category) { %><p class="field-error"><%= errors.category %></p><% } %>
  </div>

  <div class="field">
    <label for="price">Price <span class="hint">(leave blank for “contact for price”)</span></label>
    <input id="price" name="price" inputmode="decimal" placeholder="0.00"
           value="<%= values.priceRaw || '' %>">
    <% if (errors.price) { %><p class="field-error"><%= errors.price %></p><% } %>
  </div>
</div>

<div class="field">
  <label for="location">Location <span class="hint">(optional)</span></label>
  <input id="location" name="location" maxlength="<%= limits.location.max %>"
         placeholder="Neighbourhood, city" value="<%= values.location || '' %>">
  <% if (errors.location) { %><p class="field-error"><%= errors.location %></p><% } %>
</div>

<div class="field">
  <label for="description">Description</label>
  <textarea id="description" name="description" rows="10" required
            minlength="<%= limits.description.min %>"
            maxlength="<%= limits.description.max %>"
            placeholder="Condition, dimensions, why you're selling, pickup details…"><%= values.description || '' %></textarea>
  <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
</div>

<fieldset class="fieldset">
  <legend>How buyers reach you</legend>
  <p class="hint">
    Your email is used to relay messages and to send you the private link for
    editing this ad. It is never shown on the site.
  </p>

  <div class="field">
    <label for="contact_email">Email</label>
    <input id="contact_email" name="contact_email" type="email" required
           maxlength="<%= limits.email.max %>"
           value="<%= values.contactEmail || '' %>">
    <% if (errors.contact_email) { %><p class="field-error"><%= errors.contact_email %></p><% } %>
  </div>

  <div class="field">
    <label for="contact_phone">Phone <span class="hint">(optional)</span></label>
    <input id="contact_phone" name="contact_phone" maxlength="<%= limits.phone.max %>"
           value="<%= values.contactPhone || '' %>">
    <% if (errors.contact_phone) { %><p class="field-error"><%= errors.contact_phone %></p><% } %>
  </div>

  <label class="checkbox">
    <input type="checkbox" name="show_phone" <%= values.showPhone ? 'checked' : '' %>>
    Show my phone number on the listing
  </label>
</fieldset>
