<%- include('../partials/head') %>

<div class="form-page form-page-narrow">
  <h1>Moderator sign in</h1>

  <% if (!configured) { %>
    <div class="flash flash-warning">
      No moderator password is configured. Set <code>ADMIN_PASSWORD_HASH</code>
      in your environment (generate one with
      <code>node src/scripts/hash-password.js 'your password'</code>) and
      restart the server.
    </div>
  <% } else { %>
    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

    <form method="post" action="/admin/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autofocus
               autocomplete="current-password">
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Sign in</button>
        <a class="btn btn-ghost" href="/">Back to listings</a>
      </div>
    </form>
  <% } %>
</div>

<%- include('../partials/foot') %>
