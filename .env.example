# Copy to .env and adjust. Every value here has a working default except the
# admin password, so the app runs with no configuration at all.

# --- Server ---------------------------------------------------------------
PORT=3000
# Interface to bind. Behind a reverse proxy set this to 127.0.0.1 so nothing can
# reach the app directly -- with TRUST_PROXY=1 a direct client sets its own
# X-Forwarded-For and picks its own identity for rate limiting.
HOST=0.0.0.0
NODE_ENV=development
SITE_NAME=Rice List
# Used to build absolute links in emails.
SITE_URL=http://localhost:3000
# Required when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 when running behind a reverse proxy so client IPs are read from
# X-Forwarded-For (needed for rate limiting to work correctly).
TRUST_PROXY=0

# --- Storage --------------------------------------------------------------
DATA_DIR=data
# DATABASE_PATH=data/rice-list.db
# UPLOAD_DIR=data/uploads

# --- Moderation -----------------------------------------------------------
# Generate with: node src/scripts/hash-password.js 'your password'
ADMIN_PASSWORD_HASH=
# Plaintext alternative for local development only. Ignored if a hash is set.
# ADMIN_PASSWORD=

# --- Listing behaviour ----------------------------------------------------
LISTINGS_PER_PAGE=24
LISTING_EXPIRY_DAYS=45
MAX_IMAGES_PER_LISTING=6
MAX_IMAGE_BYTES=8388608
POSTS_PER_HOUR=5
MESSAGES_PER_HOUR=10
# Edits to a listing per hour from a single address. Uploads are buffered
# before the manage token can be checked, so this also caps how much memory an
# anonymous caller can make the server allocate.
EDITS_PER_HOUR=30
# Unresolved reports needed before a listing is hidden pending review.
AUTO_HIDE_FLAG_COUNT=5

# --- Email relay (optional) ----------------------------------------------
# Without SMTP the site still works: messages are stored and shown in the
# seller's inbox, they are just not emailed anywhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rice List <no-reply@example.com>
